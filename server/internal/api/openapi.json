{
  "openapi": "3.1.0",
  "info": {
    "title": "dsh-ee Harness API",
    "version": "1.0.0",
    "summary": "第三方 Harness 接入 dsh-ee 的中立 v1 契约（只读部分）",
    "description": "dsh-ee 面向第三方 Harness 的中立契约 v1 静态描述。运行时的实际入口、scope、模型与应用以 GET /.well-known/dsh-ee 与 /v1/capabilities 为准；本文件描述这些只读端点的形状、统一错误壳与响应头。MCP（JSON-RPC）与 npm registry 协议不在本文件内。所有 /.well-known/dsh-ee 与 /v1/* 响应都带 Dsh-EE-API-Version: 1。",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "当前 dsh-ee 实例（相对地址，按实际访问地址解析）"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "discovery",
      "description": "公开发现、能力摘要与机器可读契约"
    },
    {
      "name": "models",
      "description": "OpenAI 兼容模型网关"
    },
    {
      "name": "apps",
      "description": "只读中立微应用"
    }
  ],
  "paths": {
    "/.well-known/dsh-ee": {
      "get": {
        "operationId": "getDiscovery",
        "summary": "公开发现文档（匿名）",
        "tags": [
          "discovery"
        ],
        "description": "返回本实例的入口、鉴权方式、能力与限制。带 ETag 与 Cache-Control: private, max-age=300，支持 If-None-Match 304。文档内的端点地址按请求 Host / X-Forwarded-*（或配置的 PublicURL）生成。",
        "security": [],
        "responses": {
          "200": {
            "description": "发现文档",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControlPrivate"
              },
              "Dsh-EE-API-Version": {
                "$ref": "#/components/headers/DshEEAPIVersion"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Discovery"
                }
              }
            }
          },
          "304": {
            "description": "If-None-Match 命中，文档未变化"
          },
          "400": {
            "$ref": "#/components/responses/NeutralError"
          },
          "405": {
            "$ref": "#/components/responses/NeutralError"
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "summary": "当前令牌的能力摘要（Bearer 可选）",
        "tags": [
          "discovery"
        ],
        "description": "不带 Authorization 时返回公开子集（authenticated=false，用户数据为空数组）；带令牌时按令牌 scope 与账号权限返回模型、工具计数、微应用、技能摘要与目录 revision。带错令牌返回 401，不会静默降级为匿名。响应 Cache-Control: no-store。",
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "能力摘要",
            "headers": {
              "Dsh-EE-API-Version": {
                "$ref": "#/components/headers/DshEEAPIVersion"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestID"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControlNoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/NeutralError"
          },
          "401": {
            "$ref": "#/components/responses/NeutralError"
          },
          "405": {
            "$ref": "#/components/responses/NeutralError"
          }
        }
      }
    },
    "/v1/models": {
      "get": {
        "operationId": "listModels",
        "summary": "对外模型列表（OpenAI 形状）",
        "tags": [
          "models"
        ],
        "description": "只返回额度与令牌允许的对外模型名；上游厂商模型名不暴露。需要 models scope + 账号 llm.use 权限。",
        "responses": {
          "200": {
            "description": "模型列表",
            "headers": {
              "Dsh-EE-API-Version": {
                "$ref": "#/components/headers/DshEEAPIVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelList"
                }
              }
            }
          },
          "401": {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "message",
                  "type"
                ],
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  }
                }
              }
            },
            "description": "/v1 模型网关沿用 OpenAI 错误壳（Dsh-EE-API-Version 响应头仍在）。"
          },
          "403": {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "message",
                  "type"
                ],
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  }
                }
              }
            },
            "description": "/v1 模型网关沿用 OpenAI 错误壳（Dsh-EE-API-Version 响应头仍在）。"
          },
          "429": {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "message",
                  "type"
                ],
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  }
                }
              }
            },
            "description": "/v1 模型网关沿用 OpenAI 错误壳（Dsh-EE-API-Version 响应头仍在）。"
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "operationId": "createChatCompletion",
        "summary": "对话补全（OpenAI chat completions 子集）",
        "tags": [
          "models"
        ],
        "description": "请求体原样转发上游（model 换成上游模型名，流式时补 stream_options.include_usage）；额度、审计、上游故障转移由 dsh-ee 处理。不提供 /v1/embeddings、/v1/responses、/v1/completions。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "对话补全结果；stream=true 时为 text/event-stream",
            "headers": {
              "Dsh-EE-API-Version": {
                "$ref": "#/components/headers/DshEEAPIVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "message",
                  "type"
                ],
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  }
                }
              }
            },
            "description": "/v1 模型网关沿用 OpenAI 错误壳（Dsh-EE-API-Version 响应头仍在）。"
          },
          "401": {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "message",
                  "type"
                ],
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  }
                }
              }
            },
            "description": "/v1 模型网关沿用 OpenAI 错误壳（Dsh-EE-API-Version 响应头仍在）。"
          },
          "403": {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "message",
                  "type"
                ],
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  }
                }
              }
            },
            "description": "/v1 模型网关沿用 OpenAI 错误壳（Dsh-EE-API-Version 响应头仍在）。"
          },
          "404": {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "message",
                  "type"
                ],
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  }
                }
              }
            },
            "description": "/v1 模型网关沿用 OpenAI 错误壳（Dsh-EE-API-Version 响应头仍在）。"
          },
          "413": {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "message",
                  "type"
                ],
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  }
                }
              }
            },
            "description": "/v1 模型网关沿用 OpenAI 错误壳（Dsh-EE-API-Version 响应头仍在）。"
          },
          "429": {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "message",
                  "type"
                ],
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  }
                }
              }
            },
            "description": "/v1 模型网关沿用 OpenAI 错误壳（Dsh-EE-API-Version 响应头仍在）。"
          },
          "502": {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "message",
                  "type"
                ],
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  }
                }
              }
            },
            "description": "/v1 模型网关沿用 OpenAI 错误壳（Dsh-EE-API-Version 响应头仍在）。"
          }
        }
      }
    },
    "/v1/apps": {
      "get": {
        "operationId": "listApps",
        "summary": "只读中立微应用列表",
        "tags": [
          "apps"
        ],
        "description": "当前用户已启用 / 自动生效的微应用（不含 DSH 专属系统应用）。需要 hub scope + 工作台权限；响应 Cache-Control: no-store。",
        "responses": {
          "200": {
            "description": "微应用列表",
            "headers": {
              "Dsh-EE-API-Version": {
                "$ref": "#/components/headers/DshEEAPIVersion"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestID"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControlNoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NeutralError"
          },
          "403": {
            "$ref": "#/components/responses/NeutralError"
          }
        }
      }
    },
    "/v1/apps/{name}": {
      "get": {
        "operationId": "getApp",
        "summary": "只读中立微应用描述",
        "tags": [
          "apps"
        ],
        "description": "按应用标识返回中立描述；未对当前用户启用或不存在时 404。需要 hub scope + 工作台权限。",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "微应用标识"
          }
        ],
        "responses": {
          "200": {
            "description": "微应用描述",
            "headers": {
              "Dsh-EE-API-Version": {
                "$ref": "#/components/headers/DshEEAPIVersion"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestID"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControlNoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppDetail"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NeutralError"
          },
          "403": {
            "$ref": "#/components/responses/NeutralError"
          },
          "404": {
            "$ref": "#/components/responses/NeutralError"
          }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "operationId": "getOpenAPI",
        "summary": "静态 OpenAPI 3.1 契约（匿名）",
        "tags": [
          "discovery"
        ],
        "description": "本文件：dsh-ee 面向第三方 Harness 的中立 v1 契约静态描述，只读。带 ETag 与 Cache-Control: public, max-age=300，支持 If-None-Match 304。MCP（JSON-RPC）不在本文件内。",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 文档",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControlPublic"
              },
              "Dsh-EE-API-Version": {
                "$ref": "#/components/headers/DshEEAPIVersion"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "304": {
            "description": "If-None-Match 命中，契约未变化"
          },
          "400": {
            "$ref": "#/components/responses/NeutralError"
          },
          "405": {
            "$ref": "#/components/responses/NeutralError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "ee_at_<token>",
        "description": "员工接入令牌；设备码流程或网页「我的令牌」获取。scope 与账号 RBAC 求交。"
      }
    },
    "headers": {
      "DshEEAPIVersion": {
        "description": "中立 API 主版本，当前恒为 1",
        "schema": {
          "type": "string",
          "enum": [
            "1"
          ]
        }
      },
      "XRequestID": {
        "description": "请求号；中立端点响应均带，错误体 request_id 与它一致",
        "schema": {
          "type": "string"
        }
      },
      "ETag": {
        "description": "内容摘要，可用于 If-None-Match",
        "schema": {
          "type": "string"
        }
      },
      "CacheControlPrivate": {
        "description": "private, max-age=300",
        "schema": {
          "type": "string"
        }
      },
      "CacheControlPublic": {
        "description": "public, max-age=300",
        "schema": {
          "type": "string"
        }
      },
      "CacheControlNoStore": {
        "description": "no-store",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "NeutralError": {
        "description": "中立统一错误壳（只用于新增中立端点）",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/XRequestID"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "OpenAIError": {
        "description": "/v1 模型网关的 OpenAI 错误壳（形状不变）",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/OpenAIError"
            }
          }
        }
      }
    },
    "schemas": {
      "Discovery": {
        "type": "object",
        "required": [
          "name",
          "version",
          "api_version",
          "auth",
          "device_authorization_endpoint",
          "token_endpoint",
          "scopes_supported",
          "models",
          "mcp",
          "apps",
          "capabilities_endpoint",
          "openapi_url",
          "limits",
          "errors"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "协议里的服务名，固定为 dsh-ee",
            "examples": [
              "dsh-ee"
            ]
          },
          "version": {
            "type": "string",
            "description": "服务端构建版本（语义化版本或 dev/sha）",
            "examples": [
              "0.2.0"
            ]
          },
          "api_version": {
            "type": "string",
            "description": "中立契约主版本；请求头 Dsh-EE-API-Version 的协商依据",
            "examples": [
              "1"
            ]
          },
          "auth": {
            "$ref": "#/components/schemas/Auth"
          },
          "device_authorization_endpoint": {
            "type": "string",
            "format": "uri",
            "description": "设备码流程：申请设备码（POST，公开）"
          },
          "token_endpoint": {
            "type": "string",
            "format": "uri",
            "description": "设备码流程：轮询领取令牌（POST，公开）"
          },
          "scopes_supported": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "设备码流程可申请的 scope；admin 只能网页限时开启，不在其中"
          },
          "models": {
            "$ref": "#/components/schemas/ModelsDiscovery"
          },
          "mcp": {
            "$ref": "#/components/schemas/McpDiscovery"
          },
          "apps": {
            "$ref": "#/components/schemas/AppsDiscovery"
          },
          "capabilities_endpoint": {
            "type": "string",
            "format": "uri",
            "description": "当前令牌的能力摘要"
          },
          "openapi_url": {
            "type": "string",
            "format": "uri",
            "description": "本静态契约（OpenAPI 3.1）的可读地址"
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          },
          "errors": {
            "$ref": "#/components/schemas/ErrorsDiscovery"
          }
        }
      },
      "Auth": {
        "type": "object",
        "required": [
          "type",
          "header",
          "token_types",
          "token_flows"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "bearer"
          },
          "header": {
            "type": "string",
            "description": "请求头格式",
            "examples": [
              "Authorization: Bearer <token>"
            ]
          },
          "token_types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "支持的令牌前缀",
            "examples": [
              [
                "ee_at_"
              ]
            ]
          },
          "token_flows": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "device_code",
                "web_manual"
              ]
            },
            "description": "获取令牌的方式：device_code（RFC 8628 子集，员工在浏览器确认）/ web_manual（员工或管理员在网页生成；需要网页会话）"
          }
        }
      },
      "ModelsDiscovery": {
        "type": "object",
        "required": [
          "protocol",
          "streaming",
          "endpoint",
          "chat_completions_endpoint"
        ],
        "properties": {
          "protocol": {
            "type": "string",
            "const": "openai-chat-completions"
          },
          "streaming": {
            "type": "boolean",
            "description": "是否支持 stream=true 的 SSE 流式响应"
          },
          "endpoint": {
            "type": "string",
            "format": "uri",
            "description": "对外模型列表（OpenAI 形状）"
          },
          "chat_completions_endpoint": {
            "type": "string",
            "format": "uri",
            "description": "对话补全（OpenAI chat completions 子集）"
          }
        }
      },
      "McpDiscovery": {
        "type": "object",
        "required": [
          "transport",
          "endpoint",
          "protocol_versions"
        ],
        "properties": {
          "transport": {
            "type": "string",
            "const": "streamable-http"
          },
          "endpoint": {
            "type": "string",
            "format": "uri",
            "description": "MCP JSON-RPC 端点（Streamable HTTP；JSON-RPC 协议本身不在本 OpenAPI 文件内）"
          },
          "protocol_versions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "支持的 MCP 协议版本，新的在前"
          }
        }
      },
      "AppsDiscovery": {
        "type": "object",
        "required": [
          "web",
          "data_tools",
          "endpoint",
          "web_url"
        ],
        "properties": {
          "web": {
            "type": "boolean",
            "description": "是否有网页版微应用（/a/<slug>）"
          },
          "data_tools": {
            "type": "boolean",
            "description": "MCP 是否提供 app__/data__ 数据工具"
          },
          "endpoint": {
            "type": "string",
            "format": "uri",
            "description": "只读的微应用描述列表"
          },
          "web_url": {
            "type": "string",
            "format": "uri-template",
            "description": "网页版微应用地址模板，{slug} 换成应用标识"
          }
        }
      },
      "Limits": {
        "type": "object",
        "required": [
          "max_request_bytes",
          "max_response_bytes",
          "max_mcp_request_bytes"
        ],
        "properties": {
          "max_request_bytes": {
            "type": "integer",
            "description": "/v1/chat/completions 请求体上限（字节）"
          },
          "max_response_bytes": {
            "type": "integer",
            "description": "/v1/chat/completions 非流式响应体上限（字节）"
          },
          "max_mcp_request_bytes": {
            "type": "integer",
            "description": "/mcp JSON-RPC 请求体上限（字节）"
          }
        }
      },
      "ErrorsDiscovery": {
        "type": "object",
        "required": [
          "format",
          "documentation_url",
          "codes"
        ],
        "properties": {
          "format": {
            "type": "string",
            "description": "统一错误壳形状；/api/* 与 /v1 网关的既有形状保持不变"
          },
          "documentation_url": {
            "type": "string",
            "format": "uri",
            "description": "错误形状与错误码的机器可读文档（本 OpenAPI 文件）"
          },
          "codes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "新增中立端点当前会返回的稳定错误码"
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "required": [
          "api_version",
          "authenticated",
          "server",
          "user",
          "scopes",
          "models",
          "tools",
          "apps",
          "skills",
          "revision"
        ],
        "properties": {
          "api_version": {
            "type": "string"
          },
          "authenticated": {
            "type": "boolean",
            "description": "是否带了有效 Bearer 令牌"
          },
          "server": {
            "$ref": "#/components/schemas/ServerInfo"
          },
          "user": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UserInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "令牌的 scope；匿名时为空数组"
          },
          "models": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "当前令牌允许的对外模型名；顺序与 /v1/models 一致"
          },
          "tools": {
            "type": "object",
            "required": [
              "count"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "description": "与 /mcp tools/list 数量一致；需 connections scope"
              }
            }
          },
          "apps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/App"
            },
            "description": "当前用户已启用 / 自动生效的微应用；需 hub scope"
          },
          "skills": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SkillSummary"
            },
            "description": "当前用户可见的技能与提示词摘要（不含正文）；需 hub scope"
          },
          "revision": {
            "type": "string",
            "description": "能力目录 revision；需 hub scope"
          }
        }
      },
      "SkillSummary": {
        "type": "object",
        "required": [
          "name",
          "title",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "技能 / 提示词标识"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "skill",
              "prompt"
            ]
          }
        }
      },
      "App": {
        "type": "object",
        "required": [
          "name",
          "title",
          "starters",
          "launch",
          "delivery",
          "version",
          "web"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "微应用标识；网页版地址是 /a/<name>"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "starters": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "示例问法"
          },
          "launch": {
            "type": "string",
            "description": "在 Harness 里的打开方式（new/resume 等，由 DSH 语义定义）"
          },
          "delivery": {
            "type": "string",
            "enum": [
              "auto",
              "optional"
            ],
            "description": "auto 自动生效；optional 需要员工自己启用"
          },
          "version": {
            "type": "integer"
          },
          "web": {
            "type": "boolean",
            "description": "是否开放网页版 /a/<name>"
          }
        }
      },
      "AppList": {
        "type": "object",
        "required": [
          "api_version",
          "revision",
          "apps"
        ],
        "properties": {
          "api_version": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "apps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/App"
            }
          }
        }
      },
      "AppDetail": {
        "type": "object",
        "required": [
          "api_version",
          "app"
        ],
        "properties": {
          "api_version": {
            "type": "string"
          },
          "app": {
            "$ref": "#/components/schemas/App"
          }
        }
      },
      "Model": {
        "type": "object",
        "required": [
          "id",
          "object",
          "owned_by"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string",
            "const": "model"
          },
          "owned_by": {
            "type": "string"
          }
        }
      },
      "ModelList": {
        "type": "object",
        "required": [
          "object",
          "data"
        ],
        "properties": {
          "object": {
            "type": "string",
            "const": "list"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Model"
            }
          }
        }
      },
      "ChatCompletionRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "dsh-ee 的对外模型名（先 GET /v1/models）"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            },
            "description": "OpenAI 消息数组"
          },
          "stream": {
            "type": "boolean",
            "description": "true 时返回 text/event-stream"
          }
        },
        "additionalProperties": true,
        "description": "请求体除 model 原样转发上游；流式时服务端补 stream_options.include_usage；不支持 /v1/embeddings、/v1/responses、/v1/completions。"
      },
      "ChatCompletionResponse": {
        "type": "object",
        "additionalProperties": true,
        "description": "OpenAI chat completions 子集；上游响应体原样返回。"
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "type",
          "code",
          "message"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "错误大类，如 authentication_error / permission_error / invalid_request_error / not_found_error / server_error"
          },
          "code": {
            "type": "string",
            "description": "稳定错误码，取值见 Discovery.errors.codes"
          },
          "message": {
            "type": "string",
            "description": "给人看的说明"
          },
          "request_id": {
            "type": "string",
            "description": "请求号，与响应头 X-Request-Id 一致"
          },
          "retry_after": {
            "type": "integer",
            "description": "建议退避秒数（只在可重试错误上出现）"
          },
          "docs": {
            "type": "string",
            "description": "错误说明链接（可选）"
          },
          "supported_versions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "unsupported_api_version 时给出服务端支持的 API 主版本"
          }
        }
      },
      "OpenAIError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "code": {
                "type": "string"
              }
            }
          }
        },
        "description": "/v1 模型网关沿用 OpenAI 错误壳（Dsh-EE-API-Version 响应头仍在）。"
      },
      "ServerInfo": {
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "required": [
          "username"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "department": {
            "type": "string"
          }
        }
      }
    }
  }
}
