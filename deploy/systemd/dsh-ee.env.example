# /etc/dsh-ee/dsh-ee.env（权限 600）
DSH_EE_DSN='root@test:password@tcp(ob-host:2881)/dsh_ee'
# openssl rand -base64 32；丢了它，已存的上游 key 就解不开了
DSH_EE_SECRET_KEY=
DSH_EE_BOOTSTRAP_ADMIN=admin
DSH_EE_BOOTSTRAP_ADMIN_PASSWORD=
DSH_EE_ADDR=0.0.0.0:8080
DSH_EE_DATA_DIR=/var/lib/dsh-ee
DSH_EE_PUBLIC_URL=
DSH_EE_COOKIE_SECURE=false
# 登录失败按客户端 IP 限流：窗口内失败多少次返回 429；默认 50 次 / 15m，设成 0 关闭。
# 公司很多人共用一个出口 IP（NAT）时按人数调大，否则会误伤正常登录。
#DSH_EE_LOGIN_IP_LIMIT=50
#DSH_EE_LOGIN_IP_WINDOW=15m
# 给 Prometheus 抓取的最小指标接口 GET /metrics；默认关闭，开启后也只允许本机 / 内网来源。
#DSH_EE_METRICS=true
# 数据中台：默认在同一个服务器上建「主库名_data」，并自动建一个只读账号；设成 off 关闭
#DSH_EE_DATA_DSN='dsh_ee@your_tenant:password@tcp(ob-host:2881)/dsh_ee_data'
# 账号没有建用户的权限时，请 DBA 建一个只有这个库 SELECT 权限的账号填在这里
#DSH_EE_DATA_READ_DSN='dsh_ee_reader@your_tenant:password@tcp(ob-host:2881)/dsh_ee_data'
