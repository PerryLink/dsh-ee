# /etc/dsh-ee/dsh-ee.env（权限 600）
DSH_EE_DSN='root@test:password@tcp(ob-host:2881)/dsh_ee'
# openssl rand -base64 32；丢了它，已存的上游 key 就解不开了
DSH_EE_SECRET_KEY=
DSH_EE_BOOTSTRAP_ADMIN=admin
DSH_EE_BOOTSTRAP_ADMIN_PASSWORD=
DSH_EE_ADDR=0.0.0.0:8080
DSH_EE_DATA_DIR=/var/lib/dsh-ee
DSH_EE_PUBLIC_URL=
# 留空时按 PUBLIC_URL 自动判断：https 就加 Secure；显式 true/false 可覆盖
DSH_EE_COOKIE_SECURE=
# 旧 ee_npm_ / sk-ee- 令牌 scope 收敛：true 时 npm 令牌只剩 registry、API key 只剩模型网关；
# 默认不收敛，避免现有客户端失效。迁到 ee_at_ 令牌后再打开（docs/token-lifecycle.md）
#DSH_EE_RESTRICT_LEGACY_TOKEN_SCOPES=true
# /v1/* 与 /mcp 的每令牌限流（次/分钟），默认 60；0 或 off 关闭
#DSH_EE_RATE_LIMIT=60
# API 客户端（client_credentials）每 IP 每分钟换 token 次数，默认 120；0 或 off 关闭（只防撞库）
#DSH_EE_CLIENT_TOKEN_PER_MINUTE=120
# 登录失败按客户端 IP 限流：窗口内失败多少次返回 429；默认 50 次 / 15m，设成 0 关闭。
# 公司很多人共用一个出口 IP（NAT）时按人数调大，否则会误伤正常登录。
#DSH_EE_LOGIN_IP_LIMIT=50
#DSH_EE_LOGIN_IP_WINDOW=15m
# 给 Prometheus 抓取的最小指标接口 GET /metrics；默认关闭，开启后也只允许本机 / 内网来源。
#DSH_EE_METRICS=true
# 数据中台：默认在同一个服务器上建「主库名_data」，并自动建一个只读账号；设成 off 关闭
#DSH_EE_DATA_DSN='dsh_ee@your_tenant:password@tcp(ob-host:2881)/dsh_ee_data'
# 账号没有建用户的权限时，请 DBA 建一个只有这个库 SELECT 权限的账号填在这里
#DSH_EE_DATA_READ_DSN='dsh_ee_reader@your_tenant:password@tcp(ob-host:2881)/dsh_ee_data'
# 反向代理不在本机（含 dsh-ee 跑在容器里、由宿主机 nginx 转发）时，填代理地址/网段，逗号分隔；
# 只有来自这些地址的 X-Forwarded-For/Host/Proto 会被采信，默认只有 127.0.0.1 与 ::1
#DSH_EE_TRUSTED_PROXIES=172.17.0.0/16
# 扩展签名：受信任的签名公钥（PEM，可以放多把）；REQUIRE=1 时没签名或签名无效的扩展不让安装
#DSH_EE_EXTENSION_TRUSTED_KEYS=/etc/dsh-ee/extension-signing-keys.pem
#DSH_EE_EXTENSION_REQUIRE_SIGNATURE=0
# 企业目录：tarball 来源的主机白名单（逗号分隔，支持 *.example.com）；不设时只接受公网 https 地址
#DSH_EE_DIRECTORY_TARBALL_HOSTS='cdn.acme.internal,*.objects.acme.com'
