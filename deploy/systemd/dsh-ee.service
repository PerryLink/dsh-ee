# 不用 docker 时的部署方式：
#   install -m 755 dsh-ee /usr/local/bin/dsh-ee
#   useradd --system --home /var/lib/dsh-ee --create-home dsh-ee
#   install -d -m 700 /etc/dsh-ee && install -m 600 dsh-ee.env.example /etc/dsh-ee/dsh-ee.env  # 再编辑
#   cp dsh-ee.service /etc/systemd/system/ && systemctl enable --now dsh-ee
[Unit]
Description=dsh-ee
After=network-online.target
Wants=network-online.target

[Service]
User=dsh-ee
EnvironmentFile=/etc/dsh-ee/dsh-ee.env
ExecStart=/usr/local/bin/dsh-ee
# 健康检查：GET /healthz 只证明进程活着（liveness，恒 200）；GET /readyz 检查数据库、
# 迁移、数据目录与主密钥（readiness，未就绪返回 503）。systemd 本身没有 readiness 探针，
# 就绪判断交给负载均衡 / 外部监控调用 /readyz；需要时也可以在启动后跑一次
#（ExecStartPost 失败会把本次启动标成 failed，按需启用）：
#ExecStartPost=/usr/bin/curl -fsS --max-time 3 http://127.0.0.1:8080/readyz
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dsh-ee
PrivateTmp=true

[Install]
WantedBy=multi-user.target
